{
  "id": "platformer-default-01",
  "genre": "platformer",
  "audience": "default",
  "mechanics": ["jump", "collect", "levels"],
  "prompt": "простой платформер с монетками",
  "metrics": { "avgSessionSec": 150, "winRate": 0.55, "plays": 210 },
  "html": "<!DOCTYPE html>\n<html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>Платформер</title>\n<style>\n  html,body{margin:0;height:100%;background:#87ceeb;overflow:hidden;font-family:system-ui;touch-action:none}\n  canvas{display:block;width:100vw;height:100vh}\n  #hud{position:fixed;top:12px;left:12px;font-size:22px;color:#222;font-weight:bold;background:rgba(255,255,255,.7);padding:6px 12px;border-radius:8px}\n  #msg{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;background:rgba(0,0,0,.7);color:#fff;font-size:32px;gap:20px;text-align:center;padding:20px}\n  #msg button{font-size:24px;padding:14px 28px;border-radius:10px;border:none;background:#3af;color:#fff;font-weight:bold;cursor:pointer}\n  .ctrls{position:fixed;bottom:20px;display:flex;gap:20px;left:50%;transform:translateX(-50%)}\n  .ctrls button{width:80px;height:80px;font-size:36px;border-radius:50%;border:none;background:rgba(255,255,255,.8);box-shadow:0 4px 10px rgba(0,0,0,.2);cursor:pointer;user-select:none}\n  .ctrls button:active{background:#ddd}\n</style>\n</head><body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\">🪙 <span id=\"coins\">0</span></div>\n<div id=\"msg\"><div id=\"mt\"></div><button id=\"rb\">Играть снова</button></div>\n<div class=\"ctrls\"><button id=\"left\">◀</button><button id=\"jump\">⬆</button><button id=\"right\">▶</button></div>\n<script>\n(function(){\n  var c=document.getElementById('c'),ctx=c.getContext('2d');\n  var W,H,player,platforms,coins,goal,keys={},state,coinsGot;\n  function resize(){W=c.width=innerWidth;H=c.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function reset(){\n    player={x:50,y:H-200,w:36,h:46,vx:0,vy:0,onGround:false};\n    platforms=[\n      {x:0,y:H-40,w:W,h:40},{x:200,y:H-140,w:120,h:20},\n      {x:380,y:H-220,w:120,h:20},{x:560,y:H-300,w:120,h:20},\n      {x:W-200,y:H-380,w:160,h:20}\n    ];\n    coins=[{x:250,y:H-180,t:0},{x:430,y:H-260,t:0},{x:610,y:H-340,t:0},{x:W-120,y:H-420,t:0}];\n    goal={x:W-100,y:H-440,w:40,h:60};\n    coinsGot=0;state='playing';document.getElementById('coins').textContent='0';document.getElementById('msg').style.display='none';\n  }\n  function draw(){\n    ctx.fillStyle='#87ceeb';ctx.fillRect(0,0,W,H);\n    ctx.fillStyle='#8b4513';\n    platforms.forEach(function(p){ctx.fillRect(p.x,p.y,p.w,p.h)});\n    coins.forEach(function(co){if(!co.got){ctx.font='28px serif';ctx.fillText('🪙',co.x,co.y)}});\n    ctx.font='40px serif';ctx.fillText('🏁',goal.x,goal.y+40);\n    ctx.font='44px serif';ctx.fillText('🧍',player.x,player.y+player.h);\n  }\n  function update(){\n    if(state!=='playing')return;\n    var speed=5;\n    if(keys.left)player.vx=-speed;else if(keys.right)player.vx=speed;else player.vx=0;\n    if(keys.jump&&player.onGround){player.vy=-14;player.onGround=false}\n    player.vy+=0.8;player.x+=player.vx;player.y+=player.vy;\n    player.onGround=false;\n    platforms.forEach(function(p){\n      if(player.x+player.w>p.x&&player.x<p.x+p.w&&player.y+player.h>p.y&&player.y+player.h<p.y+p.h+player.vy+2){\n        if(player.vy>0){player.y=p.y-player.h;player.vy=0;player.onGround=true}\n      }\n    });\n    if(player.x<0)player.x=0;if(player.x+player.w>W)player.x=W-player.w;\n    if(player.y>H+100){state='lose';show('Упал в пропасть!')}\n    coins.forEach(function(co){\n      if(!co.got&&Math.abs(player.x+18-co.x)<30&&Math.abs(player.y+23-co.y)<30){co.got=true;coinsGot++;document.getElementById('coins').textContent=coinsGot}\n    });\n    if(player.x+player.w>goal.x&&player.y+player.h>goal.y){state='win';show('Победа! 🏁')}\n  }\n  function show(t){document.getElementById('mt').textContent=t;document.getElementById('msg').style.display='flex'}\n  function loop(){requestAnimationFrame(loop);update();draw()}\n  addEventListener('keydown',function(e){if(e.key==='ArrowLeft')keys.left=true;if(e.key==='ArrowRight')keys.right=true;if(e.key===' '||e.key==='ArrowUp')keys.jump=true;if(['ArrowLeft','ArrowRight',' ','ArrowUp'].indexOf(e.key)>=0)e.preventDefault()});\n  addEventListener('keyup',function(e){if(e.key==='ArrowLeft')keys.left=false;if(e.key==='ArrowRight')keys.right=false;if(e.key===' '||e.key==='ArrowUp')keys.jump=false});\n  function bind(id,k){var el=document.getElementById(id);el.addEventListener('touchstart',function(e){e.preventDefault();keys[k]=true});el.addEventListener('touchend',function(){keys[k]=false});el.addEventListener('mousedown',function(){keys[k]=true});el.addEventListener('mouseup',function(){keys[k]=false})}\n  bind('left','left');bind('right','right');bind('jump','jump');\n  document.getElementById('rb').addEventListener('click',reset);\n  reset();loop();\n})();\n</script>\n</body></html>"
}
