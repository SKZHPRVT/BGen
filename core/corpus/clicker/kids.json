{
  "id": "clicker-kids-01",
  "genre": "clicker",
  "audience": "kids",
  "theme": "котики",
  "mechanics": ["tap", "upgrade", "score"],
  "prompt": "кликер с котиками для детей",
  "metrics": { "avgSessionSec": 240, "winRate": 0.75, "plays": 342 },
  "html": "<!DOCTYPE html>\n<html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>Котики</title>\n<style>\n  html,body{margin:0;height:100%;background:linear-gradient(180deg,#ffd6e7,#ffb3d1);font-family:'Comic Sans MS',system-ui,sans-serif;overflow:hidden;user-select:none;touch-action:manipulation}\n  #wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:20px;box-sizing:border-box;gap:16px}\n  #score{font-size:48px;font-weight:bold;color:#c2185b;text-shadow:2px 2px 0 #fff}\n  #cat{font-size:160px;cursor:pointer;transition:transform .08s;line-height:1;filter:drop-shadow(0 4px 8px rgba(0,0,0,.15))}\n  #cat:active{transform:scale(.9)}\n  #upgrades{display:flex;gap:12px;flex-wrap:wrap;justify-content:center}\n  .up{background:#fff;border:4px solid #f48fb1;border-radius:20px;padding:14px 20px;font-size:18px;font-weight:bold;color:#c2185b;cursor:pointer;font-family:inherit;box-shadow:0 4px 0 #f48fb1;transition:all .1s}\n  .up:active{transform:translateY(2px);box-shadow:0 2px 0 #f48fb1}\n  .up:disabled{opacity:.4;cursor:not-allowed}\n  #win{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;background:rgba(255,192,203,.95);gap:24px;text-align:center;padding:20px}\n  #win h1{font-size:56px;color:#c2185b;margin:0}\n  #win button{font-size:28px;padding:18px 40px;border-radius:20px;border:none;background:#c2185b;color:#fff;font-weight:bold;cursor:pointer;font-family:inherit}\n  #pop{position:fixed;font-size:40px;pointer-events:none;animation:rise .8s ease-out forwards;font-weight:bold;color:#c2185b}\n  @keyframes rise{from{opacity:1;transform:translateY(0)}to{opacity:0;transform:translateY(-80px)}}\n</style>\n</head><body>\n<div id=\"wrap\">\n  <div id=\"score\">😺 0</div>\n  <div id=\"cat\">🐱</div>\n  <div id=\"upgrades\"></div>\n</div>\n<div id=\"win\"><h1>🎉 Ты собрал 100 котиков!</h1><button id=\"again\">Ещё раз!</button></div>\n<script>\n(function(){\n  var score=0,scorePerTap=1,autoRate=0,goal=100;\n  var scoreEl=document.querySelector('#score'),cat=document.getElementById('cat'),upEl=document.getElementById('upgrades'),win=document.getElementById('win');\n  var upgrades=[\n    {id:'tap',label:'+1 за тап',cost:10,buy:function(){scorePerTap++}},\n    {id:'auto',label:'Авто-котик',cost:25,buy:function(){autoRate+=0.5}},\n    {id:'x2',label:'x2 множитель',cost:50,buy:function(){scorePerTap*=2}}\n  ];\n  var bought={};\n  function render(){\n    scoreEl.textContent='😺 '+Math.floor(score);\n    upEl.innerHTML='';\n    upgrades.forEach(function(u){\n      var b=document.createElement('button');b.className='up';\n      b.textContent=u.label+' ('+u.cost+' 😺)';\n      b.disabled=score<u.cost||bought[u.id];\n      b.onclick=function(){\n        if(score<u.cost||bought[u.id])return;\n        score-=u.cost;u.buy();bought[u.id]=true;render();\n      };\n      upEl.appendChild(b);\n    });\n  }\n  function pop(x,y,txt){\n    var el=document.createElement('div');el.id='pop';el.textContent=txt;el.style.left=x+'px';el.style.top=y+'px';\n    document.body.appendChild(el);setTimeout(function(){el.remove()},800);\n  }\n  cat.addEventListener('click',function(e){\n    score+=scorePerTap;\n    pop(e.clientX-20,e.clientY-40,'+'+scorePerTap);\n    cat.textContent=['🐱','😸','😻','😽'][Math.floor(Math.random()*4)];\n    checkWin();render();\n  });\n  cat.addEventListener('touchstart',function(e){\n    var t=e.touches[0];\n    score+=scorePerTap;pop(t.clientX-20,t.clientY-40,'+'+scorePerTap);\n    e.preventDefault();checkWin();render();\n  },{passive:false});\n  function checkWin(){if(score>=goal&&!win.dataset.done){win.dataset.done='1';win.style.display='flex'}}\n  setInterval(function(){if(autoRate>0){score+=autoRate;checkWin();render()}},1000);\n  document.getElementById('again').addEventListener('click',function(){\n    score=0;scorePerTap=1;autoRate=0;bought={};delete win.dataset.done;win.style.display='none';render();\n  });\n  render();\n})();\n</script>\n</body></html>"
}
