{
  "id": "snake-elderly-01",
  "genre": "snake",
  "audience": "elderly",
  "mechanics": ["grow", "collect", "score"],
  "prompt": "замути змейку для бабушки",
  "metrics": { "avgSessionSec": 180, "winRate": 0.62, "plays": 128 },
  "html": "<!DOCTYPE html>\n<html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>Змейка</title>\n<style>\n  html,body{margin:0;height:100%;background:#f5f5dc;font-family:Arial,sans-serif;overflow:hidden;touch-action:none}\n  #hud{position:fixed;top:20px;left:20px;font-size:32px;font-weight:bold;color:#222;text-shadow:1px 1px 0 #fff}\n  #msg{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;gap:24px;background:rgba(0,0,0,.75);color:#fff;font-size:36px;text-align:center;padding:20px}\n  #msg button{font-size:32px;padding:24px 48px;border-radius:16px;border:none;background:#2a9;color:#fff;font-weight:bold;cursor:pointer;min-width:200px;min-height:80px}\n  canvas{display:block;width:100vw;height:100vh}\n  #tip{position:fixed;bottom:20px;left:50%;transform:translateX(-50%);font-size:22px;color:#444;background:#fff;padding:12px 24px;border-radius:12px;box-shadow:0 2px 8px rgba(0,0,0,.15)}\n</style>\n</head><body>\n<canvas id=\"c\"></canvas>\n<div id=\"hud\">Счёт: <span id=\"s\">0</span></div>\n<div id=\"tip\">Свайп или стрелки — двигай змейку</div>\n<div id=\"msg\"><div id=\"mt\"></div><button id=\"rb\">Играть снова</button></div>\n<script>\n(function(){\n  var c=document.getElementById('c'),ctx=c.getContext('2d');\n  var S=14,snake,dir,food,score,state,tick=0,lastMove=0;\n  var sEl=document.getElementById('s'),msg=document.getElementById('msg'),mt=document.getElementById('mt'),rb=document.getElementById('rb');\n  function resize(){c.width=innerWidth;c.height=innerHeight}\n  resize();addEventListener('resize',resize);\n  function reset(){snake=[{x:6,y:6},{x:5,y:6},{x:4,y:6}];dir={x:1,y:0};score=0;sEl.textContent='0';state='playing';tick=0;lastMove=0;placeFood();msg.style.display='none'}\n  function placeFood(){var ok=false;while(!ok){food={x:Math.floor(Math.random()*S),y:Math.floor(Math.random()*S)};ok=!snake.some(function(s){return s.x===food.x&&s.y===food.y})}}\n  function step(){var h={x:snake[0].x+dir.x,y:snake[0].y+dir.y};\n    if(h.x<0||h.y<0||h.x>=S||h.y>=S||snake.some(function(s){return s.x===h.x&&s.y===h.y})){state='gameover';mt.innerHTML='Игра окончена!<br>Счёт: '+score;msg.style.display='flex';return}\n    snake.unshift(h);\n    if(h.x===food.x&&h.y===food.y){score++;sEl.textContent=score;placeFood()}else snake.pop()\n  }\n  function draw(){var cell=Math.min(c.width,c.height)/S,offX=(c.width-cell*S)/2,offY=(c.height-cell*S)/2;\n    ctx.fillStyle='#f5f5dc';ctx.fillRect(0,0,c.width,c.height);\n    ctx.fillStyle='#e8e0c0';ctx.fillRect(offX,offY,cell*S,cell*S);\n    ctx.fillStyle='#d33';ctx.fillRect(offX+food.x*cell+3,offY+food.y*cell+3,cell-6,cell-6);\n    for(var i=0;i<snake.length;i++){ctx.fillStyle=i===0?'#1a5':'#2a7';ctx.fillRect(offX+snake[i].x*cell+2,offY+snake[i].y*cell+2,cell-4,cell-4)}\n  }\n  function loop(t){requestAnimationFrame(loop);if(state==='playing'&&t-lastMove>200){lastMove=t;step()}draw()}\n  addEventListener('keydown',function(e){\n    if((e.key==='ArrowUp'||e.key==='w')&&dir.y===0)dir={x:0,y:-1};\n    else if((e.key==='ArrowDown'||e.key==='s')&&dir.y===0)dir={x:0,y:1};\n    else if((e.key==='ArrowLeft'||e.key==='a')&&dir.x===0)dir={x:-1,y:0};\n    else if((e.key==='ArrowRight'||e.key==='d')&&dir.x===0)dir={x:1,y:0}\n  });\n  var tx=0,ty=0;\n  c.addEventListener('touchstart',function(e){tx=e.touches[0].clientX;ty=e.touches[0].clientY;e.preventDefault()},{passive:false});\n  c.addEventListener('touchend',function(e){var dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;\n    if(Math.abs(dx)<30&&Math.abs(dy)<30)return;\n    if(Math.abs(dx)>Math.abs(dy)){if(dx>0&&dir.x===0)dir={x:1,y:0};else if(dx<0&&dir.x===0)dir={x:-1,y:0}}\n    else{if(dy>0&&dir.y===0)dir={x:0,y:1};else if(dy<0&&dir.y===0)dir={x:0,y:-1}}\n  },{passive:false});\n  rb.addEventListener('click',reset);\n  reset();requestAnimationFrame(loop);\n})();\n</script>\n</body></html>"
}
