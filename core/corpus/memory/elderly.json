{
  "id": "memory-elderly-01",
  "genre": "memory",
  "audience": "elderly",
  "mechanics": ["match", "tap", "score"],
  "prompt": "мемори для пожилых с крупными карточками",
  "metrics": { "avgSessionSec": 220, "winRate": 0.7, "plays": 156 },
  "html": "<!DOCTYPE html>\n<html lang=\"ru\"><head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,user-scalable=no\">\n<title>Мемори</title>\n<style>\n  html,body{margin:0;height:100%;background:#fdf6e3;font-family:Arial,sans-serif;overflow:hidden;user-select:none;touch-action:manipulation}\n  #wrap{display:flex;flex-direction:column;align-items:center;justify-content:center;height:100%;padding:16px;box-sizing:border-box;gap:12px}\n  #info{font-size:24px;color:#333;font-weight:bold}\n  #grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px;max-width:600px;width:100%}\n  .card{aspect-ratio:1;border-radius:16px;background:#a1887f;display:flex;align-items:center;justify-content:center;font-size:56px;cursor:pointer;transition:transform .15s,background .15s;box-shadow:0 3px 6px rgba(0,0,0,.2)}\n  .card:active{transform:scale(.97)}\n  .card.open{background:#fff3e0}\n  .card.matched{background:#c8e6c9;cursor:default}\n  #win{position:fixed;inset:0;display:none;align-items:center;justify-content:center;flex-direction:column;background:rgba(0,0,0,.8);color:#fff;font-size:32px;gap:20px;text-align:center;padding:20px}\n  #win button{font-size:26px;padding:16px 32px;border-radius:12px;border:none;background:#4caf50;color:#fff;font-weight:bold;cursor:pointer;min-height:70px}\n</style>\n</head><body>\n<div id=\"wrap\">\n  <div id=\"info\">Ходы: <span id=\"moves\">0</span></div>\n  <div id=\"grid\"></div>\n</div>\n<div id=\"win\"><div>🎉 Отлично! Все пары найдены!</div><div>Ходов: <span id=\"finalMoves\">0</span></div><button id=\"again\">Ещё раз</button></div>\n<script>\n(function(){\n  var grid=document.getElementById('grid'),movesEl=document.getElementById('moves'),win=document.getElementById('win');\n  var emojis=['🍎','🌻','🐟','⭐','🍇','🌙','🐶','🎵'];\n  var deck,first,second,moves,lock;\n  function shuffle(a){a=a.slice();for(var i=a.length-1;i>0;i--){var j=Math.floor(Math.random()*(i+1));var t=a[i];a[i]=a[j];a[j]=t}return a}\n  function reset(){\n    deck=shuffle(emojis.concat(emojis)).map(function(e){return{emoji:e,open:false,matched:false}});\n    moves=0;first=null;second=null;lock=false;\n    movesEl.textContent='0';win.style.display='none';\n    render();\n  }\n  function render(){\n    grid.innerHTML='';\n    deck.forEach(function(card,idx){\n      var el=document.createElement('div');\n      el.className='card'+(card.open?' open':'')+(card.matched?' matched':'');\n      el.textContent=card.open||card.matched?card.emoji:'';\n      if(!card.matched)el.addEventListener('click',function(){flip(idx)});\n      grid.appendChild(el);\n    });\n  }\n  function flip(idx){\n    if(lock)return;\n    var card=deck[idx];\n    if(card.open||card.matched)return;\n    card.open=true;\n    if(!first)first=idx;\n    else if(!second)second=idx;\n    render();\n    if(first!==null&&second!==null){\n      moves++;movesEl.textContent=moves;\n      if(deck[first].emoji===deck[second].emoji){\n        deck[first].matched=deck[second].matched=true;\n        first=null;second=null;render();checkWin();\n      }else{\n        lock=true;\n        setTimeout(function(){deck[first].open=false;deck[second].open=false;first=null;second=null;lock=false;render()},900);\n      }\n    }\n  }\n  function checkWin(){\n    if(deck.every(function(c){return c.matched})){\n      document.getElementById('finalMoves').textContent=moves;\n      setTimeout(function(){win.style.display='flex'},400);\n    }\n  }\n  document.getElementById('again').addEventListener('click',reset);\n  reset();\n})();\n</script>\n</body></html>"
}
