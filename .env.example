# ==== LLM Providers ====
# Оставь пустыми те, что не используешь.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Порядок провайдеров через запятую. Router пробует по очереди.
LLM_PROVIDER_ORDER=manual,ollama,anthropic,openai

# ==== Server ====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ==== Telegram Mini App ====
# Для проверки initData на бэке (BotFather → твой бот)
TELEGRAM_BOT_TOKEN=

# ==== Cache & Storage ====
CACHE_MAX_ENTRIES=100
GAMES_STORAGE_DIR=./server/data/games

# ==== Generation ====
GEN_MAX_ATTEMPTS=3
GEN_TIMEOUT_MS=90000
GEN_MAX_TOKENS=8000
