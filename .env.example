# ============================================================
# BGen — пример конфигурации
# Скопируй в .env и заполни своими значениями:
#     cp .env.example .env
# ============================================================

# ==== LLM Providers ====
# Порядок провайдеров через запятую. Router пробует по очереди,
# пока один не ответит. Если все мертвы — падает на mock.
LLM_PROVIDER_ORDER=gigachat,ollama,anthropic,openai,manual,mock

# ==== GigaChat (Sber) — работает из РФ ====
# Authorization key = base64(ClientID:ClientSecret)
# Получить: https://developers.sber.ru/portal/products/gigachat-api
# Сформировать: echo -n "ClientID:ClientSecret" | base64 -w0
GIGACHAT_AUTH_KEY=
GIGACHAT_MODEL=GigaChat
GIGACHAT_SCOPE=GIGACHAT_API_PERS

# ==== Anthropic (Claude) ====
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# ==== OpenAI / OpenAI-совместимые ====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ==== Ollama (локальная LLM) ====
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:1.5b

# ==== Server ====
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ==== Telegram Mini App ====
# Токен бота от BotFather. Если пусто — auth выключен (dev-режим).
TELEGRAM_BOT_TOKEN=

# ==== Cache & Storage ====
CACHE_MAX_ENTRIES=100
GAMES_STORAGE_DIR=./server/data/games

# ==== Generation ====
GEN_MAX_ATTEMPTS=3
GEN_TIMEOUT_MS=90000
GEN_MAX_TOKENS=8000

# ==== Debug ====
# BGEN_USE_MOCK=1 — принудительно использовать mock-провайдер (для тестов без LLM)
# BGEN_ALLOW_ANONYMOUS=1 — разрешить запросы без Telegram initData
BGEN_USE_MOCK=
BGEN_ALLOW_ANONYMOUS=
LOG_LEVEL=info